# Maintainer: Samed Beyribey <ras0ir@eventualis.org>
#
# VCS package built from the master branch of the intrepidsilence/storm fork.
# The AUR package "python-stormssh" is the original 0.7.0 release; this one
# provides and replaces it.
pkgname=python-stormssh-git
_pkgname=storm
pkgver=1.1.0.r0.g0000000
pkgrel=1
pkgdesc="Command line tool to manage your ssh connections in ~/.ssh/config"
arch=('any')
url="https://github.com/intrepidsilence/storm"
license=('MIT')
depends=('python' 'python-paramiko' 'python-flask' 'python-werkzeug' 'python-termcolor')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
provides=('python-stormssh')
conflicts=('python-stormssh')
source=("git+https://github.com/intrepidsilence/storm.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --match 'v*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$_pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_pkgname"
  # pyproject's addopts need pytest-cov, which is not a check dependency
  python -m pytest tests -o addopts=""
}

package() {
  cd "$_pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 contrib/bash-completion/stormssh \
    "$pkgdir/usr/share/bash-completion/completions/storm"
}

# vim:set ts=2 sw=2 et:
